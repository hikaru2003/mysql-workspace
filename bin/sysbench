#!/usr/bin/env bash
# sysbench ラッパー
# bin/sysbench.bin の実行に必要な libmysqlclient を lib/ から解決する。
# バイナリのコンパイル時パス（/usr/local/share/sysbench/）が存在しない環境では
# share/sysbench/ 内の Lua ファイルをスクリプト名から自動解決して渡す。
WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"
export LD_LIBRARY_PATH="$WORKSPACE/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

args=()
for arg in "$@"; do
  lua="$WORKSPACE/share/sysbench/${arg}.lua"
  if [[ -f "$lua" ]]; then
    args+=("$lua")
  else
    args+=("$arg")
  fi
done

exec "$WORKSPACE/bin/sysbench.bin" "${args[@]}"
