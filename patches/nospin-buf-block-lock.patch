 }
 
-void rw_lock_s_lock_spin(rw_lock_t *lock, ulint pass, ut::Location location) {
-  ulint i = 0; /* spin round count */
+void rw_lock_s_lock_spin(rw_lock_t *lock, ulint pass, ut::Location location,
+                         ulint i_start) {
+  ulint i = i_start; /* spin round count */
   sync_array_t *sync_arr;
   uint64_t count_os_wait = 0;
 
@@ -339,7 +340,7 @@ lock_loop:
 #endif
     sync_array_wait_event(sync_arr, cell);
 
-    i = 0;
+    i = i_start;
 
     goto lock_loop;
   }
@@ -640,6 +641,66 @@ lock_loop:
   goto lock_loop;
 }
 
+void rw_lock_x_lock_nospin_func(rw_lock_t *lock, ulint pass,
+                                ut::Location location) {
+  ulint i = srv_n_spin_wait_rounds; /* spin をスキップ */
+  sync_array_t *sync_arr;
+  uint64_t count_os_wait = 0;
+  bool spinning = false;
+
+  ut_ad(rw_lock_validate(lock));
+  ut_ad(!rw_lock_own(lock, RW_LOCK_S));
+
+lock_loop:
+
+  if (rw_lock_x_lock_low(lock, pass, location.filename, location.line)) {
+    if (count_os_wait > 0) {
+      lock->count_os_wait += static_cast<uint32_t>(count_os_wait);
+    }
+    return;
+  } else {
+    if (!spinning) {
+      spinning = true;
+    }
+    os_rmb;
+    /* i >= srv_n_spin_wait_rounds なので spin loop は実行されない */
+    while (i < srv_n_spin_wait_rounds && lock->lock_word <= X_LOCK_HALF_DECR) {
+      if (srv_spin_wait_delay) {
+        ut_delay(ut::random_from_interval_fast(0, srv_spin_wait_delay));
+      }
+      i++;
+    }
+    if (i >= srv_n_spin_wait_rounds) {
+      std::this_thread::yield();
+    } else {
+      goto lock_loop;
+    }
+  }
+
+  sync_cell_t *cell;
+
+  sync_arr = sync_array_get_and_reserve_cell(lock, RW_LOCK_X, location, &cell);
+
+  rw_lock_set_waiter_flag(lock);
+
+  if (rw_lock_x_lock_low(lock, pass, location.filename, location.line)) {
+    sync_array_free_cell(sync_arr, cell);
+
+    if (count_os_wait > 0) {
+      lock->count_os_wait += static_cast<uint32_t>(count_os_wait);
+    }
+    return;
+  }
+
+  ++count_os_wait;
+
+  sync_array_wait_event(sync_arr, cell);
+
+  i = srv_n_spin_wait_rounds; /* OS wait 後も spin しない */
+
+  goto lock_loop;
+}
